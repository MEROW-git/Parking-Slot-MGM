# ==============================================================================
# SomPark Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and configure for your local environment:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Application Settings
# ------------------------------------------------------------------------------
DEBUG=True
# Required. Generate a private value and paste it below:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Only required when running the optional Express server.ts (Node 20.12+).
# Generate a second, different value using the same command.
SESSION_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1,*.run.app

# Optional slots for future integrations; currently unused by booking and payments.
# Leave blank until an integration is implemented. Never reuse an exposed key.
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
# Gemini keys must stay server-side. Maps JavaScript keys are visible in browsers
# even if loaded from .env; restrict a separate Maps key to your sites and Maps API.
# Demo bank payments need no API credentials. Real banking adapters are not implemented.

# ------------------------------------------------------------------------------
# 2. Database Configuration: Local MySQL (Recommended for Teaching & Development)
# ------------------------------------------------------------------------------
# Set DB_CONNECTION=mysql to use separate local MySQL variables.
# When DB_CONNECTION is set, these variables take precedence over DATABASE_URL.
#
# Password Notes:
# - Replace "secret" with your actual local MySQL root password.
# - If your local MySQL has NO password, leave it empty: DB_PASSWORD=
# - If your password contains '#', spaces, or special characters, wrap it in double quotes:
#   DB_PASSWORD="my#secret password"
#
# SSL Note for Local MySQL:
# - Local MySQL runs WITHOUT SSL. Leave MYSQL_SSL_CA and MYSQL_SSL_CA_PEM empty/unset.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_app_db
DB_USERNAME=root
DB_PASSWORD=secret
DB_CONN_MAX_AGE=60

# ------------------------------------------------------------------------------
# 3. Database Configuration: Remote Aiven MySQL (Commented Alternative)
# ------------------------------------------------------------------------------
# To use Aiven cloud database instead of local MySQL:
# 1. Comment out or delete DB_CONNECTION above (DB_CONNECTION must be unset!).
# 2. Uncomment DATABASE_URL and SSL variables below with your actual credentials.
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql+pymysql://avnadmin:PLACEHOLDER_PASSWORD@mysql-xxxx.aivencloud.com:port/defaultdb
# MYSQL_SSL_CA=certs/aiven-ca.pem
# MYSQL_SSL_CA_PEM=

# ------------------------------------------------------------------------------
# 4. SomPark Arrival Hold, Timeout & Anti-Spam Policy Settings
# ------------------------------------------------------------------------------
# Enable demo payment simulator (Bakong KHQR Demo Simulator)
DEMO_PAYMENT_ENABLED=True

# Deposit payment timeout in minutes before unconfirmed holds expire (default 15)
PAYMENT_TIMEOUT_MINUTES=15

# Arrival hold duration in hours for "Pay when you leave" bookings (default 3)
ARRIVAL_HOLD_HOURS=3

# Arrival window in hours after verified deposit payment for "Pay first day now" (default 5)
DEPOSIT_ARRIVAL_HOLD_HOURS=5

# Departure window in minutes granted after successful exit payment (default 5)
EXIT_WINDOW_MINUTES=5

# Overstay rate multiplier applied after reserved duration expires (default 2.0x)
DEFAULT_OVERSTAY_MULTIPLIER=2.0

# Anti-Spam & Hold Policy Defaults:
# Maximum active reservations per account (including PAYMENT_PENDING) (default 1)
MAX_ACTIVE_RESERVATIONS_PER_USER=1

# Maximum new pay-later holds per account in a rolling 24-hour period (default 3)
MAX_PAY_LATER_HOLDS_PER_24H=3

# Cooldown duration in minutes required after cancelling an unpaid hold (default 10)
UNPAID_CANCEL_COOLDOWN_MINUTES=10

# Number of unpaid no-shows within 7 days triggering temporary pay-later lockout (default 2)
UNPAID_NOSHOW_THRESHOLD=2

# Lockout penalty duration in hours for repeated unpaid no-shows (default 24)
UNPAID_NOSHOW_PENALTY_HOURS=24

# Booking request rate limit per user per minute (default 10)
BOOKING_RATE_LIMIT_PER_MINUTE=10

# Booking request rate limit per IP per minute (default 30, allows shared Wi-Fi)
BOOKING_IP_RATE_LIMIT_PER_MINUTE=30
