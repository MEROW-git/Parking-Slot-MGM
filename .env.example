# ==============================================================================
# SomPark Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and configure for your local environment:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Application Settings
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-sompark-local-dev-key-replace-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*.run.app

# ------------------------------------------------------------------------------
# 2. Database Configuration: Local MySQL (Recommended for Teaching & Development)
# ------------------------------------------------------------------------------
# Set DB_CONNECTION=mysql to use separate local MySQL variables.
# When DB_CONNECTION is set, these variables take precedence over DATABASE_URL.
#
# Password Notes:
# - Replace "secret" with your actual local MySQL root password.
# - If your local MySQL has NO password, leave it empty: DB_PASSWORD=
# - If your password contains '#', spaces, or special characters, wrap it in double quotes:
#   DB_PASSWORD="my#secret password"
#
# SSL Note for Local MySQL:
# - Local MySQL runs WITHOUT SSL. Leave MYSQL_SSL_CA and MYSQL_SSL_CA_PEM empty/unset.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_app_db
DB_USERNAME=root
DB_PASSWORD=secret
DB_CONN_MAX_AGE=60

# ------------------------------------------------------------------------------
# 3. Database Configuration: Remote Aiven MySQL (Commented Alternative)
# ------------------------------------------------------------------------------
# To use Aiven cloud database instead of local MySQL:
# 1. Comment out or delete DB_CONNECTION above (DB_CONNECTION must be unset!).
# 2. Uncomment DATABASE_URL and SSL variables below with your actual credentials.
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql+pymysql://avnadmin:PLACEHOLDER_PASSWORD@mysql-xxxx.aivencloud.com:port/defaultdb
# MYSQL_SSL_CA=certs/aiven-ca.pem
# MYSQL_SSL_CA_PEM=

# ------------------------------------------------------------------------------
# 4. Optional Application Features & Exit Window
# ------------------------------------------------------------------------------
# Enable demo payment simulator (Bakong KHQR Demo Simulator)
DEMO_PAYMENT_ENABLED=True

# Exit window duration in minutes granted after successful exit payment
EXIT_WINDOW_MINUTES=5
