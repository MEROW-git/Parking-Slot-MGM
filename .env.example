# Django Configuration
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,*.run.app

# Aiven MySQL Database Connection
DATABASE_URL=mysql+pymysql://username:password@hostname:3306/defaultdb

# Aiven SSL CA: path or raw PEM certificate content
MYSQL_SSL_CA=certs/aiven-ca.pem
MYSQL_SSL_CA_PEM=
DB_CONN_MAX_AGE=60
