# Django
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty to use the local SQLite database.
# MySQL example:
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/database_name
# Test override example: DATABASE_URL=sqlite:///:memory:
DATABASE_URL=

# Relative paths are resolved from the project root.
MYSQL_SSL_CA=certs/aiven-ca.pem
DB_CONN_MAX_AGE=60
