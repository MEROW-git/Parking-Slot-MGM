<%- include('partials/header') %>

<section>
    <div class="container-fluid">
       <div class="row">
          <div class="col-md-5">
             <div class="full slider_cont_section">
                <h4><%= parking_zone.name %></h4>
                <p><i class="fa fa-map-marker text-danger"></i> <%= parking_zone.address %></p>
                <div class="button_section">
                   <a href="/book/">Book Spot</a>
                </div>
             </div>
          </div>
          <div class="col-md-7">
             <div class="col-lg-10">
                <div class="card mb-4 shadow-sm">
                   <div class="card-header">
                       <i class="fa fa-info-circle mr-1"></i> Zone Status & Availability
                   </div>
                   <div class="card-body">
                       <div class="table-responsive">
                           <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                               <thead class="thead-light">
                                   <tr>
                                    <th>Total Slots</th>
                                    <th>Occupied Slots</th>
                                    <th>Vacant Slots</th>
                                    <th>Price ($)</th>
                                    <th>Action</th>
                                   </tr>
                               </thead>
                               <tbody>
                                <tr>
                                    <td><%= parking_zone.num_of_slots %></td>
                                    <td><%= parking_zone.occupied_slots %></td>
                                    <td>
                                       <span class="badge badge-<%= parking_zone.vacant_slots > 0 ? 'success' : 'danger' %>">
                                          <%= parking_zone.vacant_slots %>
                                       </span>
                                    </td>
                                    <td>$<%= parking_zone.price %></td>
                                    <td>
                                       <% if (parking_zone.vacant_slots > 0) { %>
                                          <a href="/book/" class="btn btn-primary btn-sm">Book Parking</a>
                                       <% } else { %>
                                          <button class="btn btn-secondary btn-sm" disabled>Full</button>
                                       <% } %>
                                    </td>
                                </tr>
                               </tbody>
                           </table>
                       </div>
                       <div class="mt-3">
                          <a href="/" class="btn btn-outline-secondary btn-sm"><i class="fa fa-arrow-left"></i> Back to Zones</a>
                       </div>
                   </div>
               </div>
             </div>
          </div>
       </div>
    </div>
 </section>

<%- include('partials/footer') %>
