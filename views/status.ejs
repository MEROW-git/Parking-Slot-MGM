<%- include('partials/header', { current_page: 'zones', title: parking_zone.name + ' - SomPark Phnom Penh' }) %>

<header class="sp-page-header" id="page-header">
  <% if (parking_zone.khmer_name) { %>
    <div class="sp-page-khmer">
      <%= parking_zone.khmer_name %>
    </div>
  <% } %>
  <h1><%= parking_zone.name %></h1>
  <p><%= parking_zone.address %> · <%= parking_zone.district %></p>
</header>

<div style="display:grid; grid-template-columns:1.2fr 0.8fr; gap:2rem;" id="zone-detail-grid">
  <!-- Left Column: Overview & Availability -->
  <div>
    <!-- Availability Card -->
    <div style="background:var(--sp-surface); border:2px solid var(--sp-border-strong); padding:2rem; box-shadow:var(--sp-shadow-hard-lg); margin-bottom:2rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
        <div>
          <span style="font-size:0.85rem; font-weight:700; color:var(--sp-text-subtle); text-transform:uppercase;">Current Occupancy</span>
          <h2 style="font-size:2rem; margin-top:0.25rem;">
            <%= parking_zone.vacant_slots %> <span style="font-size:1.1rem; font-weight:600; color:var(--sp-text-muted);">/ <%= parking_zone.num_of_slots %> Vacant</span>
          </h2>
        </div>
        <div class="sp-avail-badge <%= parking_zone.availability_status %>" id="avail-badge-<%= parking_zone.slug %>">
          <span class="sp-dot" aria-hidden="true"></span>
          <span>
            <% if (parking_zone.availability_status === 'full') { %>
              FULL (ពេញ)
            <% } else if (parking_zone.availability_status === 'limited') { %>
              <%= parking_zone.vacant_slots %> SPOTS LEFT (ជិតពេញ)
            <% } else { %>
              <%= parking_zone.vacant_slots %> / <%= parking_zone.num_of_slots %> AVAILABLE (ទំនេរ)
            <% } %>
          </span>
        </div>
      </div>

      <!-- Occupancy Bar -->
      <div style="background:var(--sp-bg-alt); border:2px solid var(--sp-border-strong); height:24px; border-radius:var(--sp-radius-sm); overflow:hidden; display:flex; margin-bottom:1.5rem;">
        <div style="background:var(--sp-red); width:<%= parking_zone.occupancy_percentage %>%; height:100%; transition:width 0.3s ease;" title="Occupied: <%= parking_zone.occupied_slots %>"></div>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem; border-top:1px solid var(--sp-border); padding-top:1.25rem; text-align:center;">
        <div>
          <div style="font-size:0.8rem; font-weight:700; color:var(--sp-text-subtle);">TOTAL SLOTS</div>
          <div style="font-size:1.5rem; font-weight:800; font-family:var(--sp-font-mono);"><%= parking_zone.num_of_slots %></div>
        </div>
        <div>
          <div style="font-size:0.8rem; font-weight:700; color:var(--sp-text-subtle);">OCCUPIED</div>
          <div style="font-size:1.5rem; font-weight:800; font-family:var(--sp-font-mono); color:var(--sp-red);"><%= parking_zone.occupied_slots %></div>
        </div>
        <div>
          <div style="font-size:0.8rem; font-weight:700; color:var(--sp-text-subtle);">AVAILABLE</div>
          <div style="font-size:1.5rem; font-weight:800; font-family:var(--sp-font-mono); color:var(--sp-green);"><%= parking_zone.vacant_slots %></div>
        </div>
      </div>
    </div>

    <!-- Facility Description -->
    <div style="background:var(--sp-surface); border:2px solid var(--sp-border-strong); padding:2rem; box-shadow:var(--sp-shadow-hard);">
      <h3 style="margin-bottom:0.75rem;">Facility Information (ព័ត៌មានលម្អិត)</h3>
      <p style="color:var(--sp-text); margin-bottom:1.25rem;">
        <%= parking_zone.description || "Secured municipal parking facility in Phnom Penh, equipped with 24-hour security guards, boom barriers, and high-resolution CCTV." %>
      </p>

      <h4 style="font-size:0.95rem; margin-bottom:0.5rem; text-transform:uppercase; letter-spacing:0.05em;">Amenities & Security</h4>
      <ul style="list-style:none; display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; font-size:0.9rem; color:var(--sp-text-muted);">
        <li>24/7 Security Personnel (សន្តិសុខ)</li>
        <li>High-Definition CCTV Surveillance</li>
        <li>Automated Barrier Gates</li>
        <li>Lighting & Rain Protection</li>
      </ul>
    </div>
  </div>

  <!-- Right Column: Booking Card -->
  <div>
    <div style="background:var(--sp-surface); border:2px solid var(--sp-border-strong); padding:2rem; box-shadow:var(--sp-shadow-hard-lg); position:sticky; top:100px;">
      <div style="border-bottom:2px solid var(--sp-border); padding-bottom:1.25rem; margin-bottom:1.25rem;">
        <div style="font-size:0.85rem; font-weight:700; color:var(--sp-text-subtle); text-transform:uppercase;">Daily Rate</div>
        <div style="font-size:2.25rem; font-weight:800; font-family:var(--sp-font-mono); color:var(--sp-text);">
          <%= parking_zone.price_khr_formatted %>
        </div>
        <div style="font-size:0.85rem; color:var(--sp-text-muted);">Per booking / standard day</div>
      </div>

      <div style="margin-bottom:1.5rem;">
        <div style="font-size:0.85rem; font-weight:700; color:var(--sp-text-subtle); text-transform:uppercase; margin-bottom:0.25rem;">Hours</div>
        <div style="font-size:1.05rem; font-weight:600;"><%= parking_zone.operating_hours %></div>
      </div>

      <div style="margin-bottom:2rem;">
        <div style="font-size:0.85rem; font-weight:700; color:var(--sp-text-subtle); text-transform:uppercase; margin-bottom:0.25rem;">Location</div>
        <div style="font-size:0.95rem; color:var(--sp-text-muted);"><%= parking_zone.address %></div>
      </div>

      <% if (parking_zone.is_full) { %>
        <div class="sp-alert sp-alert-warning" style="margin-bottom:1rem;">
          This facility is currently at maximum capacity.
        </div>
        <button class="sp-btn sp-btn-secondary" style="width:100%; opacity:0.6; cursor:not-allowed;" disabled>
          Full (ចំណតពេញ)
        </button>
      <% } else { %>
        <a href="/book/?zone=<%= parking_zone.slug %>" class="sp-btn sp-btn-primary" style="width:100%; text-align:center; font-size:1.1rem; padding:0.85rem 1.5rem;" id="btn-status-book">
          Reserve This Spot (កក់ចំណតនេះ)
        </a>
      <% } %>

      <div style="margin-top:1rem; text-align:center;">
        <a href="/#parking-zones" class="sp-btn sp-btn-secondary sp-btn-sm" style="width:100%;">
          ← Back to All Zones
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
