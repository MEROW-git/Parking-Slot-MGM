<%- include('partials/header') %>

<div class="container py-4">
    <div class="row">
      <div class="col-sm-10 col-md-8 col-lg-6 mx-auto">
        <div class="card card-signin my-4 shadow">
          <div class="card-header bg-primary text-white text-center py-3">
             <h5 class="card-title mb-0 text-white"><i class="fa fa-car mr-2"></i>Book Parking Spot</h5>
          </div>
          <div class="card-body p-4">
            <% if (typeof error !== 'undefined' && error) { %>
               <div class="alert alert-danger" role="alert">
                  <%= error %>
               </div>
            <% } %>

            <form class="form-signin" method="POST" action="/book/">
              <div class="form-group mb-3">
                <label for="id_parking_zone" class="font-weight-bold">Select Parking Zone</label>
                <select name="parking_zone" id="id_parking_zone" class="form-control" required>
                  <option value="" disabled selected>-- Choose a Parking Zone --</option>
                  <% parking_zones.forEach(function(zone) { %>
                    <option value="<%= zone.name %>" <%= (zone.vacant_slots <= 0) ? 'disabled' : '' %>>
                      <%= zone.name %> (<%= zone.vacant_slots %> available) - $<%= zone.price %>/day
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="form-row">
                <div class="form-group col-md-6 mb-3">
                  <label for="id_start_date" class="font-weight-bold">Start Date</label>
                  <input type="date" name="start_date" id="id_start_date" class="form-control" required min="<%= minDate %>" />
                </div>
                <div class="form-group col-md-6 mb-3">
                  <label for="id_finish_date" class="font-weight-bold">Finish Date</label>
                  <input type="date" name="finish_date" id="id_finish_date" class="form-control" required min="<%= minDate %>" />
                </div>
              </div>

              <div class="form-group mb-3">
                <label for="id_plate_number" class="font-weight-bold">Vehicle Plate Number</label>
                <input type="text" name="plate_number" id="id_plate_number" class="form-control" placeholder="e.g. KAA123B" required title="Enter vehicle plate number" />
              </div>

              <div class="form-group mb-4">
                <label for="id_phone_number" class="font-weight-bold">Contact Phone Number</label>
                <input type="tel" name="phone_number" id="id_phone_number" class="form-control" placeholder="e.g. 0712345678" pattern="[0-9+ -]+" required title="Enter digits only" />
              </div>

              <button class="btn btn-lg btn-primary btn-block text-uppercase font-weight-bold" type="submit">
                 <i class="fa fa-check-circle mr-1"></i> Confirm Booking
              </button>
            </form>

            <div class="text-center mt-3">
               <a href="/" class="text-muted"><i class="fa fa-arrow-left"></i> Cancel & Return to Dashboard</a>
            </div>
          </div>
        </div>
      </div>
    </div>
</div>

<%- include('partials/footer') %>
