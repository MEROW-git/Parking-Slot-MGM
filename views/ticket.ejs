<%- include('partials/header', { current_page: 'ticket', title: 'Ticket #' + reservation.ticket_code + ' | SomPark Phnom Penh' }) %>

<div class="no-print" style="max-width:650px; margin:0 auto 1.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
  <a href="/all_tickets/" class="sp-btn sp-btn-secondary sp-btn-sm" id="btn-back-history">
    ← Ticket History
  </a>
  <div style="display:flex; gap:0.75rem;">
    <button onclick="window.print()" class="sp-btn sp-btn-secondary sp-btn-sm" id="btn-print-ticket">
      Print ticket (បោះពុម្ព)
    </button>
    <% if (!reservation.checked_out) { %>
      <form action="/checkout/" method="post" style="display:inline;" id="form-ticket-checkout">
        <input type="hidden" name="ticket_code" value="<%= reservation.ticket_code %>">
        <button type="submit" class="sp-btn sp-btn-primary sp-btn-sm" id="btn-checkout-ticket">
          Check Out (ចេញពីចំណត)
        </button>
      </form>
    <% } %>
  </div>
</div>

<!-- Printable Parking Ticket Sheet -->
<div class="sp-ticket-sheet" id="parking-ticket-sheet">
  <div class="sp-ticket-header">
    <div>
      <div class="sp-brand sp-ticket-brand" id="ticket-brand">
        <span class="sp-brand-mark" aria-hidden="true">P</span>
        <span class="sp-brand-copy">
          <strong>SomPark</strong>
          <small>PHNOM PENH</small>
        </span>
      </div>
      <div class="sp-ticket-khmer-tagline" id="ticket-khmer-tagline">
        ចំណតឆ្លាតវៃ សម្រាប់រាជធានីភ្នំពេញ
      </div>
    </div>
    <div style="text-align:right;">
      <% if (reservation.checked_out) { %>
        <span style="background:var(--sp-bg-alt); color:var(--sp-text-muted); font-size:0.75rem; font-weight:800; padding:0.25rem 0.65rem; border:1px solid var(--sp-border-strong);">
          CHECKED OUT (បានចេញ)
        </span>
      <% } else { %>
        <span style="background:var(--sp-green-light); color:var(--sp-green-dark); font-size:0.75rem; font-weight:800; padding:0.25rem 0.65rem; border:1px solid var(--sp-border-strong);">
          ACTIVE RESERVATION (កំពុងចត)
        </span>
      <% } %>
      <div style="font-size:0.75rem; color:var(--sp-text-muted); margin-top:0.35rem;">
        Issued: <%= reservation.created_on %>
      </div>
    </div>
  </div>

  <div style="text-align:center; margin:1.5rem 0 2rem;">
    <div style="font-size:0.8rem; font-weight:700; color:var(--sp-text-subtle); text-transform:uppercase;">
      TICKET REFERENCE CODE (លេខកូដសំបុត្រ)
    </div>
    <div class="sp-ticket-barcode" id="ticket-barcode-val" style="font-size:2rem; font-weight:800; font-family:var(--sp-font-mono); letter-spacing:0.15em; margin:0.5rem 0; color:var(--sp-text);">
      * <%= reservation.ticket_code %> *
    </div>
  </div>

  <div class="sp-ticket-details" style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; border-top:2px dashed var(--sp-border-strong); border-bottom:2px dashed var(--sp-border-strong); padding:1.5rem 0; margin-bottom:1.5rem;">
    <div>
      <div style="font-size:0.75rem; font-weight:700; color:var(--sp-text-subtle); text-transform:uppercase;">PARKING FACILITY (ទីតាំង)</div>
      <div style="font-weight:700; font-size:1.05rem; color:var(--sp-text);"><%= reservation.parking_zone %></div>
    </div>
    <div>
      <div style="font-size:0.75rem; font-weight:700; color:var(--sp-text-subtle); text-transform:uppercase;">VEHICLE PLATE (ស្លាកលេខ)</div>
      <div style="font-weight:700; font-size:1.05rem; font-family:var(--sp-font-mono); color:var(--sp-text);"><%= reservation.plate_number %></div>
    </div>
    <div>
      <div style="font-size:0.75rem; font-weight:700; color:var(--sp-text-subtle); text-transform:uppercase;">DATES (កាលបរិច្ឆេទ)</div>
      <div style="font-size:0.95rem; font-family:var(--sp-font-mono); color:var(--sp-text);"><%= reservation.start_date %> → <%= reservation.finish_date %></div>
    </div>
    <div>
      <div style="font-size:0.75rem; font-weight:700; color:var(--sp-text-subtle); text-transform:uppercase;">CONTACT PHONE (ទូរស័ព្ទ)</div>
      <div style="font-size:0.95rem; font-family:var(--sp-font-mono); color:var(--sp-text);"><%= reservation.phone_number %></div>
    </div>
  </div>

  <div style="font-size:0.8rem; color:var(--sp-text-muted); line-height:1.5; text-align:center;">
    Please present this digital pass or printed QR to the parking attendant at the gate entrance and exit.
    Rates are settled in Cambodian Riel (KHR / ៛).
  </div>
</div>

<%- include('partials/footer') %>
