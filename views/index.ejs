<%- include('partials/header', { current_page: 'home', title: 'SomPark Phnom Penh | Find and Reserve Parking' }) %>

<section class="sp-hero sp-hero-marquee" aria-labelledby="hero-heading">
  <div class="sp-hero-image" aria-hidden="true"></div>
  <div class="sp-hero-shade" aria-hidden="true"></div>
  <div class="sp-hero-copy">
    <p class="sp-hero-location">Phnom Penh · Smart parking</p>
    <h1 id="hero-heading">Phnom Penh,<br><span>parked.</span></h1>
  </div>
  <p class="sp-hero-scroll" aria-hidden="true">Live availability below</p>
</section>

<section class="sp-intro" aria-labelledby="intro-heading">
  <div class="sp-intro-copy">
    <h2 id="intro-heading">Find a space before you arrive.</h2>
    <p>Check current capacity across Phnom Penh, reserve an available slot, and keep your parking ticket on your phone.</p>
    <div class="sp-intro-actions">
      <% if (user) { %>
        <a href="/book/" class="sp-btn sp-btn-primary" id="btn-hero-book">Reserve a space</a>
        <a href="/all_tickets/" class="sp-btn sp-btn-secondary" id="btn-hero-history">View my tickets</a>
      <% } else { %>
        <a href="/user/signup/" class="sp-btn sp-btn-primary" id="btn-hero-register">Create account</a>
        <a href="/user/login" class="sp-btn sp-btn-secondary" id="btn-hero-login">Sign in</a>
      <% } %>
    </div>
  </div>

  <div class="sp-stat-strip" aria-label="Current city parking capacity">
    <div class="sp-stat-item">
      <strong class="sp-stat-val" id="stat-vacant"><%= aggregates.total_vacant %></strong>
      <span class="sp-stat-label">Spaces available</span>
    </div>
    <div class="sp-stat-item">
      <strong class="sp-stat-val" id="stat-occupied"><%= aggregates.total_occupied %></strong>
      <span class="sp-stat-label">Currently occupied</span>
    </div>
    <div class="sp-stat-item">
      <strong class="sp-stat-val" id="stat-total"><%= aggregates.total_slots %></strong>
      <span class="sp-stat-label">Total capacity</span>
    </div>
    <div class="sp-stat-item">
      <strong class="sp-stat-val sp-stat-currency">KHR</strong>
      <span class="sp-stat-label">Transparent local rates</span>
    </div>
  </div>
</section>

<section class="sp-zone-directory" id="parking-zones" aria-labelledby="zones-heading">
  <div class="sp-directory-head">
    <div>
      <h2 id="zones-heading">Parking in the city</h2>
      <p>Search live availability by location or narrow the list by district.</p>
    </div>

    <form action="/#parking-zones" method="get" class="sp-search" id="search-form">
      <% if (selected_district) { %><input type="hidden" name="district" value="<%= selected_district %>"><% } %>
      <label class="sr-only" for="search-input">Search parking zones</label>
      <input type="search" name="q" value="<%= search_query || '' %>" placeholder="Street, zone, or district" class="sp-input" id="search-input">
      <button type="submit" class="sp-btn sp-btn-primary" id="btn-search">Search</button>
      <% if (search_query || selected_district) { %><a href="/#parking-zones" class="sp-btn sp-btn-secondary" id="btn-clear-search">Reset</a><% } %>
    </form>
  </div>

  <nav class="sp-district-filter" aria-label="Filter by district">
    <a href="/#parking-zones" class="sp-filter-link <%= !selected_district ? 'active' : '' %>" id="filter-all">All locations</a>
    <% districts.forEach(function(dist) { %>
      <a href="/?district=<%= encodeURIComponent(dist) %>#parking-zones" class="sp-filter-link <%= selected_district === dist ? 'active' : '' %>" id="filter-<%= dist.toLowerCase().replace(/[\s\/]+/g, '-') %>"><%= dist %></a>
    <% }); %>
  </nav>

  <% if (all_parking_zones && all_parking_zones.length > 0) { %>
    <div class="sp-zone-board" id="zones-container">
      <% all_parking_zones.forEach(function(zone, idx) { %>
        <article class="sp-zone-card <%= zone.is_full ? 'full-zone' : '' %>" id="zone-card-<%= zone.slug %>">
          <div class="sp-zone-index" aria-hidden="true"><%= String(idx + 1).padStart(2, '0') %></div>
          <div>
            <div class="sp-zone-header">
              <div>
                <h3 class="sp-zone-title">
                  <a href="/zone/<%= zone.slug %>/" id="link-zone-<%= zone.slug %>"><%= zone.name %></a>
                </h3>
                <% if (zone.khmer_name) { %>
                  <p class="sp-zone-khmer"><%= zone.khmer_name %></p>
                <% } %>
              </div>
              <div class="sp-avail-badge <%= zone.availability_status %>" id="avail-badge-<%= zone.slug %>">
                <span class="sp-dot" aria-hidden="true"></span>
                <span>
                  <% if (zone.availability_status === 'full') { %>
                    FULL (ពេញ)
                  <% } else if (zone.availability_status === 'limited') { %>
                    <%= zone.vacant_slots %> SPOTS LEFT (ជិតពេញ)
                  <% } else { %>
                    <%= zone.vacant_slots %> / <%= zone.num_of_slots %> AVAILABLE (ទំនេរ)
                  <% } %>
                </span>
              </div>
            </div>

            <p class="sp-zone-address"><%= zone.address %></p>

            <div class="sp-zone-meta">
              <div>
                <div class="sp-meta-label">Rate</div>
                <div class="sp-meta-value">
                  <%= zone.price_khr_formatted %> <span>/ day</span>
                </div>
              </div>
              <div>
                <div class="sp-meta-label">Hours</div>
                <div class="sp-meta-hours"><%= zone.operating_hours %></div>
              </div>
            </div>
          </div>

          <div class="sp-zone-footer">
            <a href="/zone/<%= zone.slug %>/" class="sp-btn sp-btn-secondary sp-btn-sm" id="btn-details-<%= zone.slug %>">
              View Map & Info
            </a>
            <% if (zone.is_full) { %>
              <span class="sp-btn sp-btn-secondary sp-btn-sm disabled">
                Full (ពេញ)
              </span>
            <% } else { %>
              <a href="/book/?zone=<%= zone.slug %>" class="sp-btn sp-btn-primary sp-btn-sm" id="btn-book-<%= zone.slug %>">
                Reserve (កក់)
              </a>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  <% } else { %>
    <div class="sp-empty-card" style="background:var(--sp-surface); border:2px solid var(--sp-border-strong); padding:3rem 2rem; text-align:center; margin-top:2rem;">
      <h3>No parking zones found</h3>
      <p style="color:var(--sp-text-muted); margin:0.5rem 0 1.5rem;">No locations match the current filters. Clear the search to view every available zone.</p>
      <a href="/#parking-zones" class="sp-btn sp-btn-secondary">View all locations</a>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
