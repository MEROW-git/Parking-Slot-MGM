<%- include('partials/header') %>

<section>
    <div class="container-fluid">
       <div class="row">
          <div class="col-md-5">
             <div class="full slider_cont_section">
                <h4>My Parking</h4>
                <h4>Spot</h4>
                <div class="button_section mb-3">
                   <a href="/book/">Reserve</a>
                </div>
                <div class="button_section">
                   <a href="/checkout/">Checkout</a>
                </div>
             </div>
          </div>
          <div class="col-md-7">
             <div class="col-lg-10">
                <div class="card mb-4 shadow-sm">
                   <div class="card-header">
                       <i class="fa fa-table mr-1"></i> Parking Zones Overview
                   </div>
                   <div class="card-body">
                       <div class="table-responsive">
                           <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                               <thead class="thead-light">
                                   <tr>
                                       <th>Parking Zone</th>
                                       <th>Location</th>
                                       <th>Vacant Slots</th>
                                       <th>Price ($)</th>
                                       <th>Action</th>
                                   </tr>
                               </thead>
                               <tfoot>
                                   <tr>
                                     <th>Parking Zone</th>
                                     <th>Location</th>
                                     <th>Vacant Slots</th>
                                     <th>Price ($)</th>
                                     <th>Action</th>
                                   </tr>
                               </tfoot>
                               <tbody>
                                   <% all_parking_zones.forEach(function(parking_zone) { %>
                                   <tr>
                                       <td><strong><a href="/zone/<%= parking_zone.slug %>/"><%= parking_zone.name %></a></strong></td>
                                       <td><%= parking_zone.address %></td>
                                       <td>
                                          <span class="badge badge-<%= parking_zone.vacant_slots > 0 ? 'success' : 'danger' %>">
                                             <%= parking_zone.vacant_slots %> / <%= parking_zone.num_of_slots %>
                                          </span>
                                       </td>
                                       <td>$<%= parking_zone.price %></td>
                                       <td>
                                          <a href="/zone/<%= parking_zone.slug %>/" class="btn btn-sm btn-info text-white">Details</a>
                                       </td>
                                   </tr>
                                   <% }); %>
                               </tbody>
                           </table>
                       </div>
                   </div>
               </div>
             </div>
          </div>
       </div>
    </div>
 </section>

<%- include('partials/footer') %>
