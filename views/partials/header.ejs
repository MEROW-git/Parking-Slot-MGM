<!DOCTYPE html>
<html lang="km-KH">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="SomPark - Smart Parking Management System for Phnom Penh Capital. Real-time availability, booking, and digital ticketing in KHR.">
  <meta property="og:title" content="SomPark - Phnom Penh Smart Parking">
  <meta property="og:description" content="ចំណតឆ្លាតវៃ សម្រាប់រាជធានីភ្នំពេញ - Smart Parking for Phnom Penh Capital">
  <title><%= typeof title !== 'undefined' ? title : 'SomPark - Smart Parking Phnom Penh' %></title>

  <!-- SomPark Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=JetBrains+Mono:wght@500;700&family=Noto+Sans+Khmer:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- SomPark Design System -->
  <link rel="stylesheet" href="/static/css/sompark.css">
</head>
<body class="page-<%= typeof current_page !== 'undefined' ? current_page : 'default' %>">
  <a class="sp-skip-link" href="#main-content">Skip to main content</a>

  <nav class="sp-navbar" aria-label="Main navigation">
    <div class="sp-container sp-nav-inner">
      <a href="/" class="sp-brand" id="brand-logo" aria-label="SomPark Phnom Penh">
        <span class="sp-brand-mark" aria-hidden="true">P</span>
        <span class="sp-brand-copy"><strong>SomPark</strong><small>Phnom Penh</small></span>
      </a>

      <ul class="sp-nav-links" id="main-nav-menu">
        <li><a href="/#parking-zones" class="sp-nav-link <%= typeof current_page !== 'undefined' && current_page === 'home' ? 'active' : '' %>" id="nav-home">Find parking</a></li>
        <% if (user) { %>
          <li><a href="/book/" class="sp-nav-link <%= typeof current_page !== 'undefined' && current_page === 'book' ? 'active' : '' %>" id="nav-book">Reserve</a></li>
          <li><a href="/all_tickets/" class="sp-nav-link <%= typeof current_page !== 'undefined' && current_page === 'tickets' ? 'active' : '' %>" id="nav-tickets">My tickets</a></li>
        <% } else { %>
          <li><a href="/user/login" class="sp-nav-link <%= typeof current_page !== 'undefined' && current_page === 'login' ? 'active' : '' %>" id="nav-login">My tickets</a></li>
        <% } %>
      </ul>

      <div class="sp-nav-auth">
        <% if (user) { %>
          <span class="sp-user-greeting" id="user-greeting"><%= user.username %></span>
          <a href="/user/logout/" class="sp-btn sp-btn-secondary sp-btn-sm" id="btn-logout" title="Sign out of SomPark">
            Sign out
          </a>
        <% } else { %>
          <a href="/user/login" class="sp-btn sp-btn-secondary sp-btn-sm sp-nav-login" id="btn-nav-login">Sign in</a>
          <a href="/user/signup/" class="sp-btn sp-btn-primary sp-btn-sm" id="btn-nav-signup">Create account</a>
        <% } %>
        <button class="sp-mobile-toggle" id="btn-mobile-toggle" aria-label="Toggle navigation" aria-controls="main-nav-menu" aria-expanded="false">
          <span aria-hidden="true">Menu</span>
        </button>
      </div>
    </div>
  </nav>

  <main class="sp-main" id="main-content">
    <div class="sp-container">
      <!-- Flash Messages -->
      <% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
        <div class="no-print sp-system-messages" id="system-messages" style="margin-bottom: 1.5rem;">
          <% messages.forEach(function(msg, idx) { %>
            <div class="sp-alert sp-alert-<%= msg.type === 'error' || msg.type === 'danger' ? 'error' : msg.type === 'warning' ? 'warning' : msg.type === 'success' ? 'success' : 'info' %>" role="alert" id="alert-<%= idx %>">
              <strong><%= msg.type === 'success' ? 'Confirmed' : msg.type === 'warning' ? 'Attention' : msg.type === 'error' ? 'Error' : 'Notice' %></strong>
              <div><%= msg.text %></div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <!-- Active Reservation Banner -->
      <% if (typeof active_reservation !== 'undefined' && active_reservation && typeof current_page !== 'undefined' && current_page !== 'ticket') { %>
        <div class="no-print" style="margin-bottom: 2rem;">
          <div class="sp-res-banner" id="active-res-banner">
            <div>
              <div class="sp-res-statusline">
                <span class="sp-res-status">Active reservation</span>
                <span class="sp-res-ticket">Ticket #<%= active_reservation.ticket_code %></span>
              </div>
              <h3><%= active_reservation.parking_zone %></h3>
              <p class="sp-res-copy">
                Plate: <strong><%= active_reservation.plate_number %></strong> ·
                Dates: <strong><%= active_reservation.start_date %></strong> to <strong><%= active_reservation.finish_date %></strong>
              </p>
            </div>
            <div class="sp-res-actions">
              <a href="/ticket/<%= active_reservation.ticket_code %>" class="sp-btn sp-btn-secondary sp-btn-sm" id="btn-view-ticket">
                View Ticket
              </a>
              <form action="/checkout/" method="post" class="sp-inline-form" id="form-checkout-banner" style="display:inline;">
                <input type="hidden" name="ticket_code" value="<%= active_reservation.ticket_code %>">
                <button type="submit" class="sp-btn sp-btn-primary sp-btn-sm" id="btn-checkout-banner" onclick="return confirm('Confirm check out from <%= active_reservation.parking_zone %>?');">
                  Check Out (ចេញពីចំណត)
                </button>
              </form>
            </div>
          </div>
        </div>
      <% } %>
