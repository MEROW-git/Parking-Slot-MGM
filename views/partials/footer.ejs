    </div>
  </main>

  <footer class="sp-footer" role="contentinfo">
    <div class="sp-container">
      <p class="sp-footer-statement">Park first.<br>Enjoy the city.</p>
      <div class="sp-footer-meta">
        <a href="/" class="sp-footer-wordmark">SomPark</a>
        <div class="sp-footer-links" aria-label="Footer navigation">
          <a href="/#parking-zones">Availability</a>
          <a href="/book/">Reserve</a>
          <a href="/all_tickets/">Tickets</a>
        </div>
        <p>© <%= new Date().getFullYear() %> · Phnom Penh · Rates in KHR / ៛</p>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const toggle = document.getElementById('btn-mobile-toggle');
      const menu = document.getElementById('main-nav-menu');
      if (toggle && menu) {
        toggle.style.display = window.innerWidth <= 960 ? 'inline-flex' : 'none';
        window.addEventListener('resize', () => {
          toggle.style.display = window.innerWidth <= 960 ? 'inline-flex' : 'none';
        });
        toggle.addEventListener('click', () => {
          menu.classList.toggle('mobile-active');
          toggle.setAttribute('aria-expanded', menu.classList.contains('mobile-active') ? 'true' : 'false');
        });
      }
    });
  </script>
</body>
</html>
