<%- include('partials/header', { current_page: 'tickets', title: 'Reservation History | SomPark Phnom Penh' }) %>

<header class="sp-page-header" id="page-header">
  <div class="sp-page-khmer">
    ប្រវត្តិការកក់ចំណត
  </div>
  <h1>My Parking Reservations</h1>
  <p>Complete history of all parking sessions and official tickets</p>
</header>

<% if (reservations && reservations.length > 0) { %>
  <div style="background:var(--sp-surface); border:2px solid var(--sp-border-strong); box-shadow:var(--sp-shadow-hard-lg); overflow-x:auto;">
    <table style="width:100%; border-collapse:collapse; text-align:left; font-size:0.95rem;" id="tickets-table">
      <thead>
        <tr style="background:var(--sp-bg-alt); border-bottom:2px solid var(--sp-border-strong);">
          <th style="padding:1rem 1.25rem; font-weight:800; font-size:0.85rem; text-transform:uppercase;">Ticket Code</th>
          <th style="padding:1rem 1.25rem; font-weight:800; font-size:0.85rem; text-transform:uppercase;">Zone (ទីតាំង)</th>
          <th style="padding:1rem 1.25rem; font-weight:800; font-size:0.85rem; text-transform:uppercase;">Vehicle Plate</th>
          <th style="padding:1rem 1.25rem; font-weight:800; font-size:0.85rem; text-transform:uppercase;">Duration</th>
          <th style="padding:1rem 1.25rem; font-weight:800; font-size:0.85rem; text-transform:uppercase;">Status</th>
          <th style="padding:1rem 1.25rem; font-weight:800; font-size:0.85rem; text-transform:uppercase; text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% reservations.forEach(function(ticket) { %>
          <tr style="border-bottom:1px solid var(--sp-border);" id="row-ticket-<%= ticket.ticket_code %>">
            <td style="padding:1.1rem 1.25rem; font-family:var(--sp-font-mono); font-weight:700;">
              <a href="/ticket/<%= ticket.ticket_code %>" style="color:var(--sp-text); text-decoration:underline;">
                <%= ticket.ticket_code %>
              </a>
            </td>
            <td style="padding:1.1rem 1.25rem;">
              <strong><%= ticket.parking_zone %></strong>
            </td>
            <td style="padding:1.1rem 1.25rem; font-family:var(--sp-font-mono); font-weight:700;">
              <%= ticket.plate_number %>
            </td>
            <td style="padding:1.1rem 1.25rem; font-size:0.85rem;">
              <%= ticket.start_date %> → <%= ticket.finish_date %>
            </td>
            <td style="padding:1.1rem 1.25rem;">
              <% if (ticket.checked_out) { %>
                <span class="sp-avail-badge" style="background:var(--sp-bg-alt); color:var(--sp-text-muted);">
                  COMPLETED (បានចេញ)
                </span>
              <% } else { %>
                <span class="sp-avail-badge available">
                  <span class="sp-dot"></span> ACTIVE (កំពុងចត)
                </span>
              <% } %>
            </td>
            <td style="padding:1.1rem 1.25rem; text-align:right;">
              <div style="display:inline-flex; gap:0.5rem;">
                <a href="/ticket/<%= ticket.ticket_code %>" class="sp-btn sp-btn-secondary sp-btn-sm" id="btn-view-<%= ticket.ticket_code %>">
                  View
                </a>
                <% if (!ticket.checked_out) { %>
                  <form action="/checkout/" method="post" style="display:inline;" id="form-co-<%= ticket.ticket_code %>">
                    <input type="hidden" name="ticket_code" value="<%= ticket.ticket_code %>">
                    <button type="submit" class="sp-btn sp-btn-primary sp-btn-sm" id="btn-co-<%= ticket.ticket_code %>" onclick="return confirm('Check out of <%= ticket.parking_zone %>?');">
                      Check Out
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div style="background:var(--sp-surface); border:2px solid var(--sp-border-strong); padding:3.5rem 2rem; text-align:center; box-shadow:var(--sp-shadow-hard);">
    <h3>No active or past tickets found</h3>
    <p style="color:var(--sp-text-muted); margin:0.75rem 0 1.5rem;">You have not booked any parking slots yet.</p>
    <a href="/#parking-zones" class="sp-btn sp-btn-primary">Find Available Parking (ស្វែងរកកន្លែងចត)</a>
  </div>
<% } %>

<%- include('partials/footer') %>
