<%- include('partials/header') %>

<section>
    <div class="container-fluid py-4">
       <div class="row">
          <div class="col-md-4">
             <div class="full slider_cont_section">
                <h4>Ticket Records</h4>
                <p>User: <strong><%= user.username %></strong></p>
                <div class="button_section mb-3">
                   <a href="/ticket/">Print Latest Ticket</a>
                </div>
                <div class="button_section">
                   <a href="/book/">Reserve New Spot</a>
                </div>
             </div>
          </div>
          <div class="col-md-8">
             <div class="card mb-4 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-ticket mr-1"></i> Your Reservations History</span>
                    <small class="text-muted">Today: <%= today %></small>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped" id="dataTable" width="100%" cellspacing="0">
                            <thead class="thead-light">
                                <tr>
                                  <th>Ticket Code</th>
                                  <th>Start Date</th>
                                  <th>Finish Date</th>
                                  <th>Parking Zone</th>
                                  <th>Plate Number</th>
                                  <th>Status</th>
                                  <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (reservations && reservations.length > 0) { %>
                                  <% reservations.forEach(function(reservation) { %>
                                  <tr>
                                      <td><code><%= reservation.ticket_code %></code></td>
                                      <td><%= reservation.start_date %></td>
                                      <td><%= reservation.finish_date %></td>
                                      <td><%= reservation.parking_zone %></td>
                                      <td><%= reservation.plate_number %></td>
                                      <td>
                                         <% if (reservation.checked_out) { %>
                                           <span class="badge badge-secondary">Checked Out</span>
                                         <% } else { %>
                                           <span class="badge badge-success">Active</span>
                                         <% } %>
                                      </td>
                                      <td>
                                         <% if (!reservation.checked_out) { %>
                                           <a href="/checkout/" class="btn btn-sm btn-outline-danger">Checkout</a>
                                         <% } else { %>
                                           <span class="text-muted small">Completed</span>
                                         <% } %>
                                      </td>
                                  </tr>
                                  <% }); %>
                                <% } else { %>
                                  <tr>
                                     <td colspan="7" class="text-center text-muted py-3">No reservation records found.</td>
                                  </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3">
                       <a href="/" class="btn btn-outline-secondary btn-sm"><i class="fa fa-arrow-left"></i> Back to Home</a>
                    </div>
                </div>
            </div>
          </div>
       </div>
    </div>
 </section>

<%- include('partials/footer') %>
