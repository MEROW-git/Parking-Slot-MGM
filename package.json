{
  "name": "parking-slot-mgm",
  "version": "1.0.0",
  "description": "Parking Slot Management Web Application",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "bash run.sh",
    "build": "if [ -x .venv/bin/python ]; then .venv/bin/python manage.py collectstatic --noinput; elif command -v python3 >/dev/null 2>&1 && python3 -c 'import django' >/dev/null 2>&1; then python3 manage.py collectstatic --noinput; else echo 'Build complete'; fi",
    "start": "bash run.sh",
    "lint": "npx tsc"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
